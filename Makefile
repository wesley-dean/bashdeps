# Canonical development, validation, and release entry points for bashdeps.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c

SRC_DIR := src
DIST_DIR := dist
SOURCE := $(SRC_DIR)/bashdeps.bash
DEV_ARTIFACT := $(DIST_DIR)/bashdeps.dev.bash
DEV_CHECKSUM := $(DEV_ARTIFACT).256
DIST_ARTIFACT := $(DIST_DIR)/bashdeps.bash
DIST_CHECKSUM := $(DIST_ARTIFACT).256
LEGACY_CHECKSUMS := $(DIST_DIR)/SHA256SUMS

TESTS_DIR := tests
TEST_SCRIPTS := $(TESTS_DIR)/*.bats
TEST_HELPERS := $(TESTS_DIR)/test_helper.bash
COMPAT_TEST := $(TESTS_DIR)/compat-bash.bash

VENDOR_DIR := vendor
DEPENDENCY_MANIFEST := dependencies.txt
BASHDEPS_TOOL := $(VENDOR_DIR)/bashdeps.bash
BASHDEPS_VERSION := 0.0.5
BASHDEPS_URL := https://github.com/wesley-dean/bashdeps/releases/download/v$(BASHDEPS_VERSION)/bashdeps.bash
BASHDEPS_SHA256 := 697ae6a65c016faa219ba60e38b255f2de3a27c337abbe4675e8246661cfcc94
DOXYGEN_BASH_FILTER := $(VENDOR_DIR)/doxygen-bash.awk
REFERENCE_DOC_DIR := doc/reference

VERSION ?= 0.0.0-dev
BUILD_COMMIT ?= $(shell git rev-parse --short=12 HEAD 2>/dev/null || printf 'unknown')
BUILD_DATE ?= $(shell git show -s --format=%cI HEAD 2>/dev/null || printf 'unknown')

.PHONY: all build check clean deps distclean docs docs-clean format test test-source test-dev test-dist FORCE

all: build

build: $(SOURCE)
	mkdir -p "$(DIST_DIR)"
	rm -f "$(LEGACY_CHECKSUMS)"
	{ \
		printf '%s\n' '#!/usr/bin/env bash'; \
		printf '%s\n' '#'; \
		printf '%s\n' '# Generated by make build. Do not edit directly.'; \
		printf '%s\n' '# Maintained source: src/bashdeps.bash'; \
		printf '\n'; \
		printf '__bashdeps_version=%q\n' "$(VERSION)"; \
		printf '__bashdeps_build_date=%q\n' "$(BUILD_DATE)"; \
		printf '__bashdeps_build_commit=%q\n' "$(BUILD_COMMIT)"; \
		printf '\n'; \
		sed '1{/^#!/d;}' "$(SOURCE)"; \
	} >"$(DEV_ARTIFACT).tmp"
	chmod 0755 "$(DEV_ARTIFACT).tmp"
	mv "$(DEV_ARTIFACT).tmp" "$(DEV_ARTIFACT)"
	{ \
		printf '%s\n' '#!/usr/bin/env bash'; \
		printf '%s\n' '#'; \
		printf '%s\n' '# Generated by make build. Do not edit directly.'; \
		printf '%s\n' '# Maintained source: src/bashdeps.bash'; \
		printf '\n'; \
		printf '__bashdeps_version=%q\n' "$(VERSION)"; \
		printf '__bashdeps_build_date=%q\n' "$(BUILD_DATE)"; \
		printf '__bashdeps_build_commit=%q\n' "$(BUILD_COMMIT)"; \
		printf '\n'; \
		sed '1{/^#!/d;}; /^[[:space:]]*#/d' "$(SOURCE)"; \
	} >"$(DIST_ARTIFACT).tmp"
	chmod 0755 "$(DIST_ARTIFACT).tmp"
	mv "$(DIST_ARTIFACT).tmp" "$(DIST_ARTIFACT)"
	@if command -v sha256sum >/dev/null 2>&1; then \
		cd "$(DIST_DIR)"; \
		sha256sum "$(notdir $(DEV_ARTIFACT))" >"$(notdir $(DEV_CHECKSUM)).tmp"; \
		sha256sum "$(notdir $(DIST_ARTIFACT))" >"$(notdir $(DIST_CHECKSUM)).tmp"; \
	elif command -v shasum >/dev/null 2>&1; then \
		cd "$(DIST_DIR)"; \
		shasum -a 256 "$(notdir $(DEV_ARTIFACT))" >"$(notdir $(DEV_CHECKSUM)).tmp"; \
		shasum -a 256 "$(notdir $(DIST_ARTIFACT))" >"$(notdir $(DIST_CHECKSUM)).tmp"; \
	else \
		printf '%s\n' 'No SHA-256 command is available for build checksums' >&2; \
		exit 1; \
	fi
	mv "$(DEV_CHECKSUM).tmp" "$(DEV_CHECKSUM)"
	mv "$(DIST_CHECKSUM).tmp" "$(DIST_CHECKSUM)"

check:
	bash -n "$(SOURCE)" $(TEST_HELPERS) "$(COMPAT_TEST)"
	shellcheck "$(SOURCE)"

format:
	shfmt -w -i 2 -ci "$(SOURCE)" $(TEST_HELPERS) "$(COMPAT_TEST)"

test: test-source test-dev test-dist

test-source:
	BASHDEPS_EXECUTABLE="$(SOURCE)" bats $(TEST_SCRIPTS)
	BASHDEPS_EXECUTABLE="$$(pwd)/$(SOURCE)" bash "$(COMPAT_TEST)"

test-dev: build
	bash -n "$(DEV_ARTIFACT)"
	test -x "$(DEV_ARTIFACT)"
	test "$$(sed -n '1p' "$(DEV_ARTIFACT)")" = '#!/usr/bin/env bash'
	BASHDEPS_EXECUTABLE="$(DEV_ARTIFACT)" bats $(TEST_SCRIPTS)
	BASHDEPS_EXECUTABLE="$$(pwd)/$(DEV_ARTIFACT)" bash "$(COMPAT_TEST)"
	cd "$(DIST_DIR)" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c "$(notdir $(DEV_CHECKSUM))"; else shasum -a 256 -c "$(notdir $(DEV_CHECKSUM))"; fi

test-dist: build
	bash -n "$(DIST_ARTIFACT)"
	test -x "$(DIST_ARTIFACT)"
	test "$$(sed -n '1p' "$(DIST_ARTIFACT)")" = '#!/usr/bin/env bash'
	BASHDEPS_EXECUTABLE="$(DIST_ARTIFACT)" bats $(TEST_SCRIPTS)
	BASHDEPS_EXECUTABLE="$$(pwd)/$(DIST_ARTIFACT)" bash "$(COMPAT_TEST)"
	cd "$(DIST_DIR)" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c "$(notdir $(DIST_CHECKSUM))"; else shasum -a 256 -c "$(notdir $(DIST_CHECKSUM))"; fi
	test ! -e "$(LEGACY_CHECKSUMS)"

##
# Force the bootstrap target to verify its existing bytes on every dependency sync.
#
FORCE:

##
# Bootstrap the pinned released bashdeps executable used to process dependencies.txt.
#
$(BASHDEPS_TOOL): FORCE
	@mkdir -p "$(VENDOR_DIR)"
	@hash_file() { \
		if command -v sha256sum >/dev/null 2>&1; then \
			sha256sum "$$1" | awk '{print $$1}'; \
		elif command -v shasum >/dev/null 2>&1; then \
			shasum -a 256 "$$1" | awk '{print $$1}'; \
		else \
			printf '%s\n' 'No SHA-256 command is available to verify bashdeps.bash' >&2; \
			return 1; \
		fi; \
	}; \
	if [[ -f "$@" ]] && [[ "$$(hash_file "$@")" == "$(BASHDEPS_SHA256)" ]]; then \
		exit 0; \
	fi; \
	tmp="$@.tmp"; \
	trap 'rm -f "'"'"'$$tmp'"'"'"' EXIT; \
	curl -fsSL "$(BASHDEPS_URL)" -o "$$tmp"; \
	actual="$$(hash_file "$$tmp")"; \
	if [[ "$$actual" != "$(BASHDEPS_SHA256)" ]]; then \
		printf 'bashdeps bootstrap digest mismatch: expected %s, got %s\n' "$(BASHDEPS_SHA256)" "$$actual" >&2; \
		exit 1; \
	fi; \
	chmod 0755 "$$tmp"; \
	mv "$$tmp" "$@"; \
	trap - EXIT

##
# Synchronize manifest-managed project dependencies through the bootstrapped tool.
#
deps: $(BASHDEPS_TOOL) $(DEPENDENCY_MANIFEST)
	"$(BASHDEPS_TOOL)" sync "$(DEPENDENCY_MANIFEST)"

##
# Remove generated Doxygen reference documentation.
#
docs-clean:
	rm -rf "$(REFERENCE_DOC_DIR)"

##
# Generate browsable Doxygen reference documentation from maintained Bash source.
#
docs: docs-clean deps
	chmod 0755 "$(DOXYGEN_BASH_FILTER)"
	mkdir -p "$(REFERENCE_DOC_DIR)"
	doxygen Doxyfile

clean:
	rm -rf "$(DIST_DIR)"

##
# Remove ordinary build output, generated reference docs, and vendored dependencies.
#
distclean: clean docs-clean
	rm -rf "$(VENDOR_DIR)"
